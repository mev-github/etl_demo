FROM docker.io/apache/airflow:latest-python3.11

USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*
USER airflow

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Shared ETL library
COPY src/common /opt/etl/common

# Airflow DAGs
COPY src/pipeline_airflow/dags /opt/airflow/dags

ENV PYTHONPATH="/opt/etl:${PYTHONPATH}"
