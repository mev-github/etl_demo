# =============================================================
# .env.example -- copy to .env and fill in before first launch
# =============================================================

# ---- MySQL (source: dimension tables) ----
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=etl_user
MYSQL_PASSWORD=etl_pass
MYSQL_DATABASE=hotel_dims

# ---- PostgreSQL (target: DWH) ----
PG_USER=etl_user
PG_PASSWORD=etl_pass
PG_DATABASE=hotel_dwh

# ---- MongoDB (source: enrichment) ----
MONGO_INITDB_ROOT_USERNAME=etl_user
MONGO_INITDB_ROOT_PASSWORD=etl_pass

# ---- Airflow ----
# Generate this value before first launch (see README section 2.1).
# Do NOT leave it empty or Airflow will fail to encrypt connections.
# Better use ENV var.
AIRFLOW__CORE__FERNET_KEY='example_key'

# ---- Dagster ----
# No user-facing credentials; metadata DB is internal.
